        <a href="https://pagespeed.web.dev/report?url=<%= CGI.escape(target_url) %>" target="_blank" rel="noopener" class="flex items-center justify-between border border-slate-200 rounded-lg px-4 py-2.5 hover:border-indigo-300 hover:bg-indigo-50/40 transition">

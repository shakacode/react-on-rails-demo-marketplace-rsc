<%
  # Per-feature data — every number on this page is sourced from one of the
  # 24 Lighthouse reports under public/lighthouse-reports/. Numbers are loaded
  # at request time from the JSON files so the page stays in lock-step with
  # the artefacts under public/lighthouse-reports/.
  #
  # If you regenerate reports, refresh the page — no code change needed.
  reports_dir = Rails.root.join("public/lighthouse-reports")
  report_filename = ->(slug, variant, strategy) { "#{slug}_#{variant}-#{strategy}" }
  report_url = ->(slug, variant, strategy) { lh_compare_url_for(slug, variant, strategy) }
  app_url = ->(feature, variant, strategy) { "#{feature[:path]}/#{variant}#{strategy == "desktop" ? "?delay=50" : ""}" }

  load_report = ->(slug, variant, strategy) {
    path = reports_dir.join("#{report_filename.(slug, variant, strategy)}.json")
    return nil unless File.exist?(path)
    j = JSON.parse(File.read(path))
    a = j["audits"]
    {
      score: (j["categories"]["performance"]["score"] * 100).round,
      fcp: a["first-contentful-paint"]["numericValue"].to_f,
      lcp: a["largest-contentful-paint"]["numericValue"].to_f,
      tbt: a["total-blocking-time"]["numericValue"].to_f,
      cls: a["cumulative-layout-shift"]["numericValue"].to_f,
      si: a["speed-index"]["numericValue"].to_f,
      bootup: a["bootup-time"]["numericValue"].to_f,
      transfer: a["total-byte-weight"]["numericValue"].to_f,
    }
  }

  features = [
    { slug: "blog",           label: "Blog Post",         path: "/blog",           accent: "violet",   anchor: "blog",
      summary: "Markdown-heavy article with code blocks. Traditional approaches force the user's browser to download ~1 MB of processing libraries. RSC does that processing on the server and only sends the finished result &mdash; dramatically less data for users to download." },
    { slug: "product",        label: "Product Page",      path: "/product",        accent: "blue",     anchor: "product",
      summary: "E-commerce page with product specs, reviews, and multi-currency pricing. Traditional approaches run heavy formatting libraries in the user's browser. RSC pre-renders everything server-side, sending only the finished page." },
    { slug: "restaurant_1",   label: "Restaurant Detail", path: "/restaurant/1",   accent: "orange",   anchor: "restaurant",
      summary: "Long-form bio, 80-item menu with descriptions and pricing, 40 review threads. The largest content payload of the four pages &mdash; and exactly where RSC's server-side processing advantage is most visible." },
    { slug: "product-search", label: "Product Search",    path: "/product-search", accent: "emerald",  anchor: "product-search",
      summary: "Faceted search with filters and 4 independently loaded data sections. RSC renders the page progressively so users see results faster instead of waiting for everything to load." },
  ]

  fmt_ms  = ->(v) { v.nil? ? "—" : (v < 1000 ? "#{v.round} ms" : "#{(v/1000.0).round(2)} s") }
  fmt_kb  = ->(v) { v.nil? ? "—" : (v >= 1024*1024 ? "#{(v/1024.0/1024).round(2)} MB" : "#{(v/1024.0).round} KB") }
  diff_class = ->(rsc, ssr) { rsc.to_f < ssr.to_f ? "text-emerald-700" : (rsc.to_f > ssr.to_f ? "text-red-600" : "text-slate-500") }

  # Pre-load all report data for the page
  data = features.each_with_object({}) do |f, h|
    h[f[:slug]] = {}
    %w[ssr client rsc].each do |v|
      h[f[:slug]][v] = {}
      %w[desktop mobile].each do |s|
        h[f[:slug]][v][s] = load_report.(f[:slug], v, s)
      end
    end
  end

  # Section helpers
  score_color = ->(s) { s >= 90 ? "bg-emerald-100 text-emerald-800" : (s >= 50 ? "bg-amber-100 text-amber-800" : "bg-red-50 text-red-700") }
%>

<section class="bg-slate-900 text-white py-16 sm:py-20 lg:py-28 relative overflow-hidden" style="background-image:linear-gradient(to bottom, #0f172a, #1e1b4b, #0f172a)">
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
    <span class="inline-block text-emerald-400 font-semibold text-xs uppercase tracking-[0.2em] mb-4">Performance Evidence</span>
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-5 leading-tight">
      Every number,<br/>linked to the report that proves it.
    </h1>
    <p class="text-lg sm:text-xl text-slate-300 max-w-3xl leading-relaxed mb-8">
      24 independent performance audits across every page type. Mobile uses real-world slow network conditions; desktop uses standard browser settings. Every number links to its source report &mdash; nothing is cherry-picked.
    </p>
    <div class="flex flex-wrap gap-3 text-sm">
      <a href="/lighthouse-reports/index.html" class="inline-flex items-center gap-2 bg-white text-slate-900 font-semibold px-5 py-2.5 rounded-full hover:bg-slate-100 transition">
        Browse all 24 reports
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="/lighthouse-reports/bundle-sizes.html" class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/20 text-white font-semibold px-5 py-2.5 rounded-full hover:bg-white/20 transition">
        Bundle-size breakdown
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     AT-A-GLANCE — scores link to LH reports; strategy links open apps
     ════════════════════════════════════════════════════════════════ -->
<section class="py-14 sm:py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <span class="inline-block text-emerald-600 font-semibold text-xs uppercase tracking-[0.2em] mb-3">At a Glance</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3">Performance score, every page, every variant</h2>
      <p class="text-slate-500 max-w-3xl mx-auto">Lighthouse <code class="bg-white border border-slate-200 px-1.5 py-0.5 rounded">categories.performance.score × 100</code>. Click any score to open that exact report; use strategy links to open the measured app variants.</p>
    </div>

    <div class="overflow-x-auto bg-white rounded-2xl border border-slate-200 shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50">
            <th class="text-left p-4 text-xs uppercase tracking-wider text-slate-600">Feature</th>
            <th class="text-left p-4 text-xs uppercase tracking-wider text-slate-600">Strategy</th>
            <th class="p-4 text-xs uppercase tracking-wider text-slate-600">SSR</th>
            <th class="p-4 text-xs uppercase tracking-wider text-slate-600">Client</th>
            <th class="p-4 text-xs uppercase tracking-wider text-slate-600">RSC</th>
            <th class="p-4 text-xs uppercase tracking-wider text-slate-600">RSC vs SSR</th>
          </tr>
        </thead>
        <tbody>
          <% features.each do |f| %>
            <% %w[desktop mobile].each_with_index do |s, idx| %>
              <% ssr = data[f[:slug]]["ssr"][s]; cli = data[f[:slug]]["client"][s]; rsc = data[f[:slug]]["rsc"][s] %>
              <tr class="border-t border-slate-100 hover:bg-slate-50/50">
                <% if idx == 0 %>
                  <td rowspan="2" class="p-4 align-top">
                    <div class="font-bold text-slate-900"><%= f[:label] %></div>
                    <code class="text-xs text-slate-500"><%= f[:path] %></code>
                  </td>
                <% end %>
                <td class="p-4 text-slate-700">
                  <div class="font-medium capitalize"><%= s %></div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-semibold">
                    <a href="<%= app_url.(f, "ssr", s) %>" class="text-blue-700 hover:underline">SSR</a>
                    <span class="text-slate-300">·</span>
                    <a href="<%= app_url.(f, "client", s) %>" class="text-amber-700 hover:underline">Client</a>
                    <span class="text-slate-300">·</span>
                    <a href="<%= app_url.(f, "rsc", s) %>" class="text-emerald-700 hover:underline">RSC</a>
                  </div>
                </td>
                <td class="p-2 text-center">
                  <a href="<%= report_url.(f[:slug], "ssr", s) %>" target="_blank" rel="noopener" class="inline-block px-3 py-1 rounded-md font-bold <%= score_color.(ssr[:score]) %> hover:opacity-80 transition">
                    <%= ssr[:score] %>
                  </a>
                </td>
                <td class="p-2 text-center">
                  <a href="<%= report_url.(f[:slug], "client", s) %>" target="_blank" rel="noopener" class="inline-block px-3 py-1 rounded-md font-bold <%= score_color.(cli[:score]) %> hover:opacity-80 transition">
                    <%= cli[:score] %>
                  </a>
                </td>
                <td class="p-2 text-center">
                  <a href="<%= report_url.(f[:slug], "rsc", s) %>" target="_blank" rel="noopener" class="inline-block px-3 py-1 rounded-md font-bold <%= score_color.(rsc[:score]) %> hover:opacity-80 transition">
                    <%= rsc[:score] %>
                  </a>
                </td>
                <td class="p-2 text-center font-semibold <%= rsc[:score] > ssr[:score] ? 'text-emerald-700' : (rsc[:score] < ssr[:score] ? 'text-red-600' : 'text-slate-500') %>">
                  <%= rsc[:score] >= ssr[:score] ? "+" : "" %><%= rsc[:score] - ssr[:score] %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-slate-500 mt-3">Color: <span class="px-1.5 rounded bg-emerald-100 text-emerald-800 font-semibold">≥ 90</span> &nbsp; <span class="px-1.5 rounded bg-amber-100 text-amber-800 font-semibold">50–89</span> &nbsp; <span class="px-1.5 rounded bg-red-100 text-red-800 font-semibold">&lt; 50</span></p>

    <!-- TBT Weight Callout -->
    <div class="mt-8 bg-gradient-to-r from-purple-50 to-indigo-50 border border-purple-200 rounded-2xl p-6">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-shrink-0">
          <div class="w-20 h-20 bg-purple-100 rounded-2xl flex items-center justify-center">
            <span class="text-3xl font-black text-purple-700">30%</span>
          </div>
        </div>
        <div class="flex-1">
          <h3 class="font-bold text-slate-900 text-lg mb-2">Blocking Time has the biggest impact on Google's performance score</h3>
          <p class="text-sm text-slate-600 mb-3">
            It measures how long users wait before they can tap, scroll, or type &mdash; and it accounts for <strong class="text-purple-700">30%</strong> of the score, more than any other metric. This is why RSC pages often score higher even when other metrics are similar: less JavaScript means users can interact almost immediately.
          </p>
          <div class="flex flex-wrap gap-3 text-xs">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-purple-500"></span>
              <span class="text-slate-700"><strong>TBT:</strong> 30%</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-blue-500"></span>
              <span class="text-slate-700"><strong>LCP:</strong> 25%</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="text-slate-700"><strong>CLS:</strong> 25%</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              <span class="text-slate-700"><strong>FCP:</strong> 10%</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-slate-400"></span>
              <span class="text-slate-700"><strong>SI:</strong> 10%</span>
            </div>
          </div>
        </div>
        <div class="flex-shrink-0 md:text-right">
          <a href="https://developer.chrome.com/docs/lighthouse/performance/performance-scoring" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs text-purple-600 hover:underline">
            Lighthouse scoring docs
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     PER-FEATURE DEEP DIVES — Core Web Vitals + bundle composition
     ════════════════════════════════════════════════════════════════ -->
<% features.each_with_index do |f, idx| %>
  <% bg = idx.even? ? "bg-white" : "bg-slate-50" %>
  <% ssr_d = data[f[:slug]]["ssr"]["desktop"]; cli_d = data[f[:slug]]["client"]["desktop"]; rsc_d = data[f[:slug]]["rsc"]["desktop"] %>
  <% ssr_m = data[f[:slug]]["ssr"]["mobile"];  cli_m = data[f[:slug]]["client"]["mobile"];  rsc_m = data[f[:slug]]["rsc"]["mobile"] %>
  <% perf_delta = rsc_d[:score] - ssr_d[:score] %>
  <% transfer_save = ssr_d[:transfer] - rsc_d[:transfer] %>
  <% bootup_save = ssr_d[:bootup] - rsc_d[:bootup] %>

  <section id="<%= f[:anchor] %>" class="<%= bg %> py-14 sm:py-20" style="scroll-margin-top:3rem">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-3 gap-8 lg:gap-12 mb-10">
        <div class="lg:col-span-2">
          <span class="inline-block text-<%= f[:accent] %>-600 font-semibold text-xs uppercase tracking-[0.2em] mb-3">Demo <%= idx + 1 %> of <%= features.length %></span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3"><%= f[:label] %></h2>
          <p class="text-slate-600 leading-relaxed mb-4"><%= f[:summary] %></p>
          <div class="flex flex-wrap gap-2 text-xs">
            <a href="<%= f[:path] %>/ssr"    class="rounded-full bg-blue-50 border border-blue-200 px-3 py-1 text-blue-700 hover:bg-blue-100">Open <%= f[:label] %> SSR →</a>
            <a href="<%= f[:path] %>/client" class="rounded-full bg-amber-50 border border-amber-200 px-3 py-1 text-amber-700 hover:bg-amber-100">Open Client →</a>
            <a href="<%= f[:path] %>/rsc"    class="rounded-full bg-green-50 border border-green-200 px-3 py-1 text-green-700 font-semibold hover:bg-green-100">Open RSC →</a>
            <a href="/lighthouse-reports/bundle-sizes.html#<%= f[:anchor] %>" class="rounded-full bg-indigo-50 border border-indigo-200 px-3 py-1 text-indigo-700 hover:bg-indigo-100">Bundle breakdown →</a>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <a href="<%= report_url.(f[:slug], "rsc", "desktop") %>" target="_blank" rel="noopener" class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center hover:shadow-md transition block">
            <div class="text-2xl font-extrabold text-emerald-700"><%= perf_delta >= 0 ? "+" : "" %><%= perf_delta %></div>
            <div class="text-[10px] uppercase tracking-wider text-emerald-700 font-semibold mt-1">Perf delta</div>
            <div class="text-[10px] text-slate-500"><%= ssr_d[:score] %>→<%= rsc_d[:score] %></div>
          </a>
          <a href="/lighthouse-reports/bundle-sizes.html#<%= f[:anchor] %>" class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center hover:shadow-md transition block">
            <div class="text-2xl font-extrabold text-indigo-700"><%= transfer_save > 0 ? "−" : "+" %><%= fmt_kb.(transfer_save.abs) %></div>
            <div class="text-[10px] uppercase tracking-wider text-indigo-700 font-semibold mt-1">Transfer</div>
            <div class="text-[10px] text-slate-500">vs SSR · click ↗</div>
          </a>
          <a href="<%= report_url.(f[:slug], "rsc", "desktop") %>" target="_blank" rel="noopener" class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center hover:shadow-md transition block">
            <div class="text-2xl font-extrabold text-pink-700"><%= bootup_save > 0 ? "−" : "+" %><%= fmt_ms.(bootup_save.abs) %></div>
            <div class="text-[10px] uppercase tracking-wider text-pink-700 font-semibold mt-1">Bootup</div>
            <div class="text-[10px] text-slate-500">vs SSR · click ↗</div>
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <% [["desktop", "Desktop · unthrottled", ssr_d, cli_d, rsc_d], ["mobile", "Mobile · Slow 4G + 4× CPU", ssr_m, cli_m, rsc_m]].each do |strategy, title, ssr, cli, rsc| %>
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <h3 class="font-bold text-slate-900 mb-1"><%= title %></h3>
            <p class="text-xs text-slate-500 mb-4">Tap any number to open the report — the same JSON Lighthouse generated for that exact run.</p>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-xs text-slate-500 uppercase tracking-wider">
                  <th class="text-left py-1.5"></th>
                  <th class="py-1.5"><a href="<%= report_url.(f[:slug], "ssr", strategy) %>" target="_blank" rel="noopener" class="text-blue-700 hover:underline">SSR</a></th>
                  <th class="py-1.5"><a href="<%= report_url.(f[:slug], "client", strategy) %>" target="_blank" rel="noopener" class="text-amber-700 hover:underline">Client</a></th>
                  <th class="py-1.5"><a href="<%= report_url.(f[:slug], "rsc", strategy) %>" target="_blank" rel="noopener" class="text-emerald-700 hover:underline">RSC</a></th>
                </tr>
              </thead>
              <tbody class="font-mono text-xs">
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">Score</td>
                  <td class="text-center py-1.5 font-bold"><%= ssr[:score] %></td>
                  <td class="text-center py-1.5 font-bold"><%= cli[:score] %></td>
                  <td class="text-center py-1.5 font-bold text-emerald-700"><%= rsc[:score] %></td>
                </tr>
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">FCP <span class="text-slate-400 text-[10px]">(first paint)</span></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(ssr[:fcp]) %></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(cli[:fcp]) %></td>
                  <td class="text-center py-1.5 <%= diff_class.(rsc[:fcp], ssr[:fcp]) %>"><%= fmt_ms.(rsc[:fcp]) %></td>
                </tr>
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">LCP <span class="text-slate-400 text-[10px]">(main content visible)</span></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(ssr[:lcp]) %></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(cli[:lcp]) %></td>
                  <td class="text-center py-1.5 <%= diff_class.(rsc[:lcp], ssr[:lcp]) %>"><%= fmt_ms.(rsc[:lcp]) %></td>
                </tr>
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">TBT <span class="text-slate-400 text-[10px]">(blocking time)</span></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(ssr[:tbt]) %></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(cli[:tbt]) %></td>
                  <td class="text-center py-1.5 <%= diff_class.(rsc[:tbt], ssr[:tbt]) %>"><%= fmt_ms.(rsc[:tbt]) %></td>
                </tr>
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">Speed Index <span class="text-slate-400 text-[10px]">(perceived speed)</span></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(ssr[:si]) %></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(cli[:si]) %></td>
                  <td class="text-center py-1.5 <%= diff_class.(rsc[:si], ssr[:si]) %>"><%= fmt_ms.(rsc[:si]) %></td>
                </tr>
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">Bootup <span class="text-slate-400 text-[10px]">(JS processing)</span></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(ssr[:bootup]) %></td>
                  <td class="text-center py-1.5"><%= fmt_ms.(cli[:bootup]) %></td>
                  <td class="text-center py-1.5 <%= diff_class.(rsc[:bootup], ssr[:bootup]) %>"><%= fmt_ms.(rsc[:bootup]) %></td>
                </tr>
                <tr class="border-t border-slate-100"><td class="py-1.5 text-slate-600 font-sans">Transfer <span class="text-slate-400 text-[10px]">(data to user)</span></td>
                  <td class="text-center py-1.5"><%= fmt_kb.(ssr[:transfer]) %></td>
                  <td class="text-center py-1.5"><%= fmt_kb.(cli[:transfer]) %></td>
                  <td class="text-center py-1.5 <%= diff_class.(rsc[:transfer], ssr[:transfer]) %>"><%= fmt_kb.(rsc[:transfer]) %></td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>

      <!-- Bundle composition bar — shows what each variant ships -->
      <% rsc_pct = (rsc_d[:transfer].to_f / ssr_d[:transfer].to_f * 100).round %>
      <a href="/lighthouse-reports/bundle-sizes.html#<%= f[:anchor] %>" class="block mt-6 bg-slate-50 rounded-2xl border border-slate-200 hover:border-indigo-300 hover:shadow-md transition p-5 group">
        <div class="flex items-baseline justify-between mb-3">
          <h3 class="font-bold text-slate-900 text-sm">What ships to the client (desktop)</h3>
          <span class="text-xs text-indigo-600 group-hover:underline">Open per-chunk breakdown →</span>
        </div>
        <div class="space-y-3">
          <div>
            <div class="flex items-baseline justify-between mb-1">
              <span class="text-xs font-medium text-blue-700">SSR</span>
              <span class="text-xs font-bold text-blue-700"><%= fmt_kb.(ssr_d[:transfer]) %></span>
            </div>
            <div class="h-3 rounded-full bg-blue-200 w-full"></div>
          </div>
          <div>
            <div class="flex items-baseline justify-between mb-1">
              <span class="text-xs font-medium text-amber-700">Client</span>
              <span class="text-xs font-bold text-amber-700"><%= fmt_kb.(cli_d[:transfer]) %></span>
            </div>
            <div class="h-3 rounded-full bg-amber-200" style="width: <%= (cli_d[:transfer].to_f / ssr_d[:transfer].to_f * 100).round %>%"></div>
          </div>
          <div>
            <div class="flex items-baseline justify-between mb-1">
              <span class="text-xs font-medium text-emerald-700">RSC</span>
              <span class="text-xs font-bold text-emerald-700"><%= fmt_kb.(rsc_d[:transfer]) %> · <%= rsc_pct %>% of SSR</span>
            </div>
            <div class="h-3 rounded-full bg-emerald-400" style="width: <%= rsc_pct %>%"></div>
          </div>
        </div>
      </a>
    </div>
  </section>
<% end %>

<!-- ════════════════════════════════════════════════════════════════
     THE PATTERN — what RSC keeps server-only
     ════════════════════════════════════════════════════════════════ -->
<section class="py-14 sm:py-20 bg-slate-900 text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <span class="inline-block text-emerald-400 font-semibold text-xs uppercase tracking-[0.2em] mb-3">The Pattern</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-3">What your users no longer have to download</h2>
      <p class="text-slate-300 max-w-3xl mx-auto">Every number below links to the actual bundle evidence &mdash; the real bytes that RSC removes from what users' browsers must process.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-2xl p-5">
        <div class="text-emerald-400 font-bold text-xs uppercase tracking-wider mb-2">Markdown stack</div>
        <div class="text-3xl font-extrabold mb-1">~1 MB</div>
        <p class="text-sm text-slate-400 leading-relaxed mb-3">Content formatting libraries used for blog posts, product specs, and restaurant bios. RSC processes them on the server &mdash; users download none of this.</p>
        <a href="/lighthouse-reports/bundle-sizes.html#blog" class="text-xs text-emerald-400 hover:underline">See Blog SSR's <code>markdown-libs-…js</code> chunk →</a>
      </div>
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-2xl p-5">
        <div class="text-emerald-400 font-bold text-xs uppercase tracking-wider mb-2">Currency formatting</div>
        <div class="text-3xl font-extrabold mb-1">~30 KB</div>
        <p class="text-sm text-slate-400 leading-relaxed mb-3">Price formatting libraries for multi-currency displays in product and restaurant pages. The server formats prices once; users receive ready-to-display text.</p>
        <a href="/lighthouse-reports/bundle-sizes.html#product" class="text-xs text-emerald-400 hover:underline">See Product SSR's vendor chunks →</a>
      </div>
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-2xl p-5">
        <div class="text-emerald-400 font-bold text-xs uppercase tracking-wider mb-2">Component code</div>
        <div class="text-3xl font-extrabold mb-1">~200–400 KB</div>
        <p class="text-sm text-slate-400 leading-relaxed mb-3">Traditional approaches send the rendering code for every page section to the browser. RSC only sends the code for elements that need to be interactive &mdash; buttons, forms, and dynamic UI.</p>
        <a href="/lighthouse-reports/bundle-sizes.html#restaurant" class="text-xs text-emerald-400 hover:underline">See Restaurant SSR's entry pack →</a>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     METHODOLOGY
     ════════════════════════════════════════════════════════════════ -->
<section class="py-14 sm:py-20 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <span class="inline-block text-indigo-600 font-semibold text-xs uppercase tracking-[0.2em] mb-3">Methodology</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3">How these numbers were measured</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h3 class="font-bold text-slate-900 mb-2">Tool</h3>
        <p class="text-sm text-slate-600 mb-2">Lighthouse 12 — the same engine PageSpeed Insights uses. Each route was loaded fresh in headless Chromium; metrics are the standard <a href="https://web.dev/articles/performance-scoring" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">Lighthouse v12 weights</a> applied to FCP, LCP, TBT, CLS, and Speed Index.</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h3 class="font-bold text-slate-900 mb-2">Conditions</h3>
        <ul class="text-sm text-slate-600 space-y-1.5">
          <li><strong>Mobile:</strong> Slow 4G simulation (1.6 Mbps down, 750 Kbps up, 150 ms RTT) + 4× CPU throttle. Same as PSI mobile.</li>
          <li><strong>Desktop:</strong> 1350×940 viewport, no network throttle, 1× CPU. Same as PSI desktop.</li>
        </ul>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h3 class="font-bold text-slate-900 mb-2">Pages were warmed</h3>
        <p class="text-sm text-slate-600">Each route was hit twice via <code class="bg-slate-100 px-1 rounded">curl</code> before the audit ran, so the first-request DB cold-cache penalty was excluded. Lighthouse then performed its own load with a clean Chrome profile.</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h3 class="font-bold text-slate-900 mb-2">Reproduce</h3>
        <p class="text-sm text-slate-600 mb-2">Every report under <code class="bg-slate-100 px-1 rounded">/lighthouse-reports/</code> can be re-opened in <a href="https://googlechrome.github.io/lighthouse/viewer/" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">Lighthouse Viewer</a> by uploading its JSON. After deploy, run any URL through <a href="https://pagespeed.web.dev/" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">pagespeed.web.dev</a> to compare with field-condition equivalent.</p>
      </div>
    </div>

    <div class="mt-8 bg-white rounded-2xl border border-slate-200 p-5">
      <h3 class="font-bold text-slate-900 mb-2">Data sources for this page</h3>
      <p class="text-sm text-slate-600 mb-3">Numbers above are loaded at request time from the JSON files Lighthouse wrote. Click any of them to inspect the raw audit:</p>
      <% short = { "blog" => "blog", "product" => "product", "restaurant_1" => "restaurant", "product-search" => "search" } %>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
        <% features.each do |f| %>
          <% %w[desktop mobile].each do |s| %>
            <% %w[ssr client rsc].each do |v| %>
              <a href="<%= report_url.(f[:slug], v, s) %>" target="_blank" rel="noopener" class="rounded-md border border-slate-200 px-2 py-1.5 text-slate-700 hover:border-indigo-300 hover:bg-indigo-50/40 transition flex items-center justify-between">
                <span class="truncate"><%= short[f[:slug]] %> · <%= v %></span>
                <span class="text-slate-400 ml-1"><%= s == "desktop" ? "🖥" : "📱" %></span>
              </a>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     CHECK ON REAL TOOLING
     ════════════════════════════════════════════════════════════════ -->
<section class="py-14 sm:py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

          <line x1="482" y1="60" x2="523" y2="60" class="flow-line" stroke="#818cf8" stroke-width="2"/>
          <line x1="657" y1="60" x2="698" y2="60" class="flow-line" stroke="#818cf8" stroke-width="2"/>

          <!-- Arrow tips -->

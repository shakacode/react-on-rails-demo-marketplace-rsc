<% content_for(:page_title) { "How to Measure React Server Components Performance" } %>
<% content_for(:page_description) do %>
  Reproduce these results yourself: run Lighthouse against every RSC, SSR, and
  client-side variant of the demo and compare the numbers.
<% end %>
<%
  page_specs = [
    ["Blog SSR",    "/blog/ssr",    "https://rsc.reactonrails.com/blog/ssr"],
    ["Blog Client", "/blog/client", "https://rsc.reactonrails.com/blog/client"],
    ["Blog RSC",    "/blog/rsc",    "https://rsc.reactonrails.com/blog/rsc"],
    ["Product SSR",    "/product/ssr",    "https://rsc.reactonrails.com/product/ssr"],
    ["Product Client", "/product/client", "https://rsc.reactonrails.com/product/client"],
    ["Product RSC",    "/product/rsc",    "https://rsc.reactonrails.com/product/rsc"],
    ["Product PPR",    "/product/ppr",    "https://rsc.reactonrails.com/product/ppr"],
    ["Product RSC Pull", "/product/rsc-pull", "https://rsc.reactonrails.com/product/rsc-pull"],
    ["Restaurant Detail SSR",    "/restaurant/1/ssr",    "https://rsc.reactonrails.com/restaurant/1/ssr"],
    ["Restaurant Detail Client", "/restaurant/1/client", "https://rsc.reactonrails.com/restaurant/1/client"],
    ["Restaurant Detail RSC",    "/restaurant/1/rsc",    "https://rsc.reactonrails.com/restaurant/1/rsc"],
    ["Product Search SSR",    "/product-search/ssr",    "https://rsc.reactonrails.com/product-search/ssr"],
    ["Product Search Client", "/product-search/client", "https://rsc.reactonrails.com/product-search/client"],
    ["Product Search RSC",    "/product-search/rsc",    "https://rsc.reactonrails.com/product-search/rsc"],
  ]

  reports_dir = Rails.root.join("public/lighthouse-reports")
  load_lh = ->(slug, variant) {
    path = reports_dir.join("#{slug}_#{variant}-desktop.json")
    next nil unless File.exist?(path)
    j = JSON.parse(File.read(path)); a = j["audits"]
    fmt_ms = ->(v) { v < 1000 ? "#{v.round} ms" : "#{(v/1000.0).round(1)} s" }
    {
      score: (j["categories"]["performance"]["score"] * 100).round,
      fcp: fmt_ms.(a["first-contentful-paint"]["numericValue"].to_f),
      lcp: fmt_ms.(a["largest-contentful-paint"]["numericValue"].to_f),
      tbt: fmt_ms.(a["total-blocking-time"]["numericValue"].to_f),
      cls: a["cumulative-layout-shift"]["numericValue"].round(2).to_s,
      si:  fmt_ms.(a["speed-index"]["numericValue"].to_f),
    }
  }

  scorecards = %w[ssr client rsc].map do |v|
    d = load_lh.("blog", v)
    label = { "ssr" => "V1 — SSR", "client" => "V2 — Client (loadable)", "rsc" => "V3 — RSC streaming" }[v]
    color = d[:score] >= 90 ? "emerald" : "amber"
    {
      label: label, score: d[:score], color: color,
      fcp: d[:fcp], lcp: d[:lcp], tbt: d[:tbt], cls: d[:cls], si: d[:si],
      report: lh_compare_url_for("blog", v, "desktop"),
      image:  "/docs-screenshots/lighthouse-blog-#{v}.png",
    }
  end
%>

<section class="bg-gradient-to-b from-slate-50 to-white border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-4 py-12 sm:py-16">
    <span class="inline-block text-emerald-600 font-semibold text-xs uppercase tracking-[0.18em] mb-3">Measurement</span>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">How to measure performance</h1>
    <p class="text-base sm:text-lg text-slate-600 max-w-3xl leading-relaxed">
      Five independent ways to measure the SSR, Client, and RSC variants in this demo. Pick whichever matches your audience: Lighthouse for the standard scorecard, the built-in <code class="bg-slate-100 rounded px-1.5 py-0.5 text-sm">pnpm vitals</code> script for headless A/B comparison, or PageSpeed Insights for deployed-URL field data.
    </p>
  </div>
</section>

<!-- ======================================================================
     SAMPLE LIGHTHOUSE RESULTS — rendered inline (no big image with white)
====================================================================== -->
<section class="bg-white border-b border-slate-200 py-12 sm:py-16">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
      <h2 class="text-2xl font-bold text-slate-900">Sample results — blog post</h2>
      <span class="text-xs text-slate-500">Lighthouse 12.8.2 · desktop preset · 50 ms delay · 2026-05-09</span>
    </div>
    <p class="text-sm text-slate-600 mb-6 max-w-3xl">
      Captured against the deployed site with <code class="bg-slate-100 rounded px-1.5 py-0.5 text-xs">npx lighthouse &lt;url&gt;?delay=50 --preset=desktop --only-categories=performance</code>. Click any score to drill into the full Lighthouse HTML report.
    </p>

    <div class="mb-8">
      <%= render "shared/delay_notice" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% scorecards.each do |c| %>
        <% ring = c[:color] == "emerald" ? "border-emerald-500 text-emerald-600" : "border-amber-500 text-amber-600" %>
        <a href="<%= c[:report] %>" target="_blank" rel="noopener"
           class="group bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all">
          <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-[0.14em] mb-4"><%= c[:label] %></div>
          <div class="flex items-center gap-5">
            <div class="w-24 h-24 rounded-full border-[8px] <%= ring %> flex items-center justify-center text-3xl font-extrabold tabular-nums">
              <%= c[:score] %>
            </div>
            <dl class="text-sm space-y-1 flex-1">
              <% [["FCP", c[:fcp], false], ["LCP", c[:lcp], false], ["TBT", c[:tbt], c[:tbt] != "0 ms"], ["CLS", c[:cls], false], ["Speed Idx", c[:si], false]].each do |k, v, bad| %>
                <div class="flex justify-between gap-3">
                  <dt class="text-slate-500"><%= k %></dt>
                  <dd class="font-semibold tabular-nums <%= bad ? "text-red-600" : "text-slate-800" %>"><%= v %></dd>
                </div>
              <% end %>
            </dl>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400">Open full report</span>
            <span class="text-indigo-600 font-medium group-hover:underline">View &rarr;</span>
          </div>
        </a>
      <% end %>
    </div>

    <details class="mt-8 group">
      <summary class="cursor-pointer text-sm font-medium text-indigo-600 hover:underline inline-flex items-center gap-1">
        Show full Lighthouse report screenshots
        <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </summary>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4">
        <% scorecards.each do |c| %>
          <a href="<%= c[:image] %>" target="_blank" class="block">
            <img src="<%= c[:image] %>" alt="Lighthouse report for <%= c[:label] %>" class="rounded-lg border border-slate-200 hover:border-indigo-300 transition-colors w-full h-auto" loading="lazy" />
          </a>
        <% end %>
      </div>
    </details>
  </div>
</section>

<!-- ======================================================================
     METHODS 1-5
====================================================================== -->
<section class="bg-slate-50 py-12 sm:py-16">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Five ways to measure</h2>
    <p class="text-sm text-slate-600 mb-8 max-w-3xl">
      In rough order of effort vs depth. The first two are interactive (one-off audits). The third is built into this repo and the most repeatable. Four and five hit deployed URLs.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

      <!-- 1. DevTools -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm">1</span>
          <h3 class="text-lg font-bold text-slate-900">Lighthouse in Chrome DevTools</h3>
        </div>
        <p class="text-sm text-slate-600 mb-4">Best for a single-page audit with the full diagnostics report (Performance + Best Practices + Accessibility + SEO).</p>
        <ol class="list-decimal list-outside space-y-1.5 text-sm text-slate-700 ml-5 mb-3">
          <li>Open the page in Chrome (incognito recommended).</li>
          <li>Open DevTools — <kbd class="bg-slate-100 border border-slate-300 rounded px-1.5 py-0.5 text-xs">Cmd</kbd>+<kbd class="bg-slate-100 border border-slate-300 rounded px-1.5 py-0.5 text-xs">Opt</kbd>+<kbd class="bg-slate-100 border border-slate-300 rounded px-1.5 py-0.5 text-xs">I</kbd> (mac) / <kbd class="bg-slate-100 border border-slate-300 rounded px-1.5 py-0.5 text-xs">F12</kbd> (Win).</li>
          <li>Switch to the <strong>Lighthouse</strong> panel.</li>
          <li>Pick <strong>Mobile</strong>, check <strong>Performance</strong>, leave <strong>Simulated throttling</strong> on, click <strong>Analyze page load</strong>.</li>
        </ol>
        <p class="text-xs text-slate-500">Run each variant from a fresh incognito window so cache state matches.</p>
      </div>

      <!-- 2. Lighthouse CLI -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm">2</span>
          <h3 class="text-lg font-bold text-slate-900">Lighthouse CLI</h3>
        </div>
        <p class="text-sm text-slate-600 mb-3">Use in CI or for repeatable per-commit benchmarks.</p>
        <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code>npx -y lighthouse http://localhost:3000/blog/rsc \
  --preset=desktop \
  --only-categories=performance \
  --output=html \
  --output-path=./tmp/lh-blog-rsc.html

# Repeat for /blog/ssr and /blog/client.</code></pre>
        <p class="text-xs text-slate-500 mt-3">Add <code class="bg-slate-100 px-1 rounded">--throttling-method=devtools</code> + <code class="bg-slate-100 px-1 rounded">--screenEmulation.mobile</code> for the mobile profile.</p>
      </div>

      <!-- 3. pnpm vitals -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm lg:col-span-2 ring-1 ring-emerald-200/60">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-sm">3</span>
          <h3 class="text-lg font-bold text-slate-900">Built-in <code class="bg-slate-100 px-1.5 py-0.5 rounded text-base">pnpm vitals</code></h3>
          <span class="ml-auto text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2 py-0.5">Recommended</span>
        </div>
        <p class="text-sm text-slate-600 mb-4">Headless Chrome (Puppeteer) script that captures FCP / LCP / TTFB / TBT / CLS / hydration / streaming / JS transfer + decoded for every variant and prints a side-by-side table. <strong>Best option for stable, reproducible benchmarks</strong> — eliminates CDN and network variance that affects PageSpeed.</p>

        <!-- Setup instructions -->
        <div class="bg-slate-50 rounded-xl p-4 mb-5 border border-slate-200">
          <p class="text-xs font-semibold text-slate-700 uppercase tracking-[0.14em] mb-3">Setup — clone &amp; build production</p>
          <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code># Clone the repo
git clone https://github.com/shakacode/react-on-rails-demo-marketplace-rsc.git
cd react-on-rails-demo-marketplace-rsc

# Install dependencies
bundle install && pnpm install

# Build production assets
NODE_ENV=production bin/shakapacker --mode production

# Start node renderer (background)
NODE_ENV=production node node-renderer.js &

# Start Rails in production mode
RAILS_ENV=production RAILS_SERVE_STATIC_FILES=true \
  SECRET_KEY_BASE=dummy_secret_key_base_for_testing_1234567890abcdef \
  bundle exec rails server -p 3000</code></pre>
          <p class="text-xs text-slate-500 mt-2"><code class="bg-slate-100 px-1 rounded">RAILS_SERVE_STATIC_FILES=true</code> required for local prod — otherwise Rails won't serve CSS/JS.</p>
        </div>

        <!-- Running benchmarks -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
          <div>
            <p class="text-xs font-semibold text-slate-700 uppercase tracking-[0.14em] mb-2">Desktop (no throttle)</p>
            <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code># Quick run (3 iterations, 1 warmup)
pnpm vitals:quick

# Full run (7 iterations, 2 warmup)
pnpm vitals

# Specific pages only
pnpm vitals -- --pages blog-ssr,blog-rsc</code></pre>
            <p class="text-xs text-slate-500 mt-2">Desktop mode = no CPU/network throttle. Fast but doesn't reveal streaming advantage.</p>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-700 uppercase tracking-[0.14em] mb-2">Mobile (throttled) — matches PSI</p>
            <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code># 4x CPU slowdown + Slow 3G network
pnpm vitals -- --throttle

# Quick + throttled
pnpm vitals:quick -- --throttle

# Throttled specific pages
pnpm vitals -- --throttle --pages blog-ssr,blog-rsc</code></pre>
            <p class="text-xs text-slate-500 mt-2"><code class="bg-slate-100 px-1 rounded">--throttle</code> = 4x CPU slowdown + Slow 3G. Matches PageSpeed Insights mobile conditions.</p>
          </div>
        </div>

        <!-- Additional options -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <p class="text-xs font-semibold text-slate-700 uppercase tracking-[0.14em] mb-2">Compare before/after</p>
            <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code># Run baseline, save with label
pnpm vitals -- --throttle --label before

# Make changes, run again
pnpm vitals -- --throttle --label after

# Compare side-by-side
pnpm vitals:compare -- \
  .vitals-results/*-before.json \
  .vitals-results/*-after.json</code></pre>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-700 uppercase tracking-[0.14em] mb-2">All available page keys</p>
            <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code>blog-ssr, blog-client, blog-rsc
product-ssr, product-client, product-rsc
search-ssr, search-client, search-rsc
restaurant-ssr, restaurant-client, restaurant-rsc
dashboard-ssr, dashboard-client, dashboard-rsc</code></pre>
            <p class="text-xs text-slate-500 mt-2">Full list in <code class="bg-slate-100 px-1 rounded">scripts/lib/constants.mjs</code></p>
          </div>
        </div>

        <p class="text-xs text-slate-500 mt-4">JSON output: <code class="bg-slate-100 px-1 rounded">.vitals-results/&lt;timestamp&gt;.json</code>. Source: <code class="bg-slate-100 px-1 rounded">scripts/measure-vitals.mjs</code>.</p>
      </div>

      <!-- 4. PageSpeed -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm">4</span>
          <h3 class="text-lg font-bold text-slate-900">PageSpeed Insights</h3>
        </div>
        <p class="text-sm text-slate-600 mb-3">Lighthouse + Chrome UX Report (real-user field data) for the production deployment at <code class="bg-slate-100 px-1 rounded text-xs">rsc.reactonrails.com</code>. Deep links by route are in the table further down the page.</p>
        <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-3 text-xs text-red-800">
          <p class="font-semibold mb-1">PageSpeed results can vary significantly for demo sites</p>
          <p>PSI scores depend on CDN cache state, server warmup, and Google infrastructure variance. For low-traffic demo sites like this one, we observed 18-32 point variance between runs. <strong>For stable, reproducible benchmarks, use <code class="bg-red-100 rounded px-1">pnpm vitals -- --throttle</code> against a local production build instead.</strong> Local benchmarks with throttling match PSI conditions (4x CPU slowdown) but eliminate network/CDN variance.</p>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mb-4 text-xs text-amber-800">
          <p class="font-semibold mb-1">Important: warm up each page before running PageSpeed</p>
          <p>Visit the page URL in your browser first (or <code class="bg-amber-100 rounded px-1">curl</code> it) to prime server caches. Cold-start times can inflate metrics by several seconds. Desktop links below include <code class="bg-amber-100 rounded px-1">?delay=50</code> to simulate production-level DB load — PageSpeed does not throttle CPU or network on desktop, so without the delay all three variants score nearly identically.</p>
        </div>
        <a href="https://pagespeed.web.dev/report?url=<%= CGI.escape("https://rsc.reactonrails.com/blog/rsc?delay=50") %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors">
          Open PageSpeed for /blog/rsc?delay=50
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M3 12h18"/></svg>
        </a>
      </div>

      <!-- 5. WebPageTest -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm">5</span>
          <h3 class="text-lg font-bold text-slate-900">WebPageTest</h3>
        </div>
        <p class="text-sm text-slate-600 mb-3">Best when you need a video filmstrip showing streaming differences side-by-side.</p>
        <pre class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs overflow-x-auto leading-relaxed"><code>npm i -g webpagetest
webpagetest test https://rsc.reactonrails.com/blog/rsc \
  --location Dulles:Chrome.3GSlow --runs 3</code></pre>
        <p class="text-xs text-slate-500 mt-3">Or paste the URL directly at <a href="https://www.webpagetest.org/" target="_blank" rel="noopener" class="text-indigo-600 hover:underline">webpagetest.org</a>.</p>
      </div>

    </div>
  </div>
</section>

<!-- ======================================================================
     ROUTES + TIPS
====================================================================== -->
<section class="bg-white py-12 sm:py-16">
  <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 gap-12">

    <div>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">All measurable routes</h2>
      <p class="text-sm text-slate-600 mb-4 max-w-3xl">Open any local URL directly. Add <code class="bg-slate-100 px-1 rounded">?delay=50</code> to simulate production DB load.</p>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z"/></svg>
          <div class="text-sm text-amber-900">
            <p class="font-semibold mb-1">Warm up before measuring</p>
            <p class="text-amber-800 text-xs leading-relaxed">
              Visit each page URL once before running PageSpeed Insights — the first request after a deploy or idle period hits a cold server and inflates all metrics.
              Desktop PageSpeed links below include <code class="bg-amber-100 rounded px-1 py-0.5 text-xs font-mono">?delay=50</code> because PageSpeed does not throttle CPU or network on desktop.
              Without the delay, this small demo app is too fast for Lighthouse to detect meaningful differences between SSR, Client, and RSC.
            </p>
          </div>
        </div>
      </div>
      <div class="overflow-hidden border border-slate-200 rounded-2xl">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-500 uppercase text-[11px] tracking-[0.12em]">
            <tr>
              <th class="text-left py-2.5 px-4 font-semibold">Page</th>
              <th class="text-left py-2.5 px-4 font-semibold">Local</th>
              <th class="text-left py-2.5 px-4 font-semibold">PageSpeed · desktop · delay=50</th>
            </tr>
          </thead>
          <tbody>
            <% page_specs.each_with_index do |(label, local, deployed), idx| %>
              <tr class="<%= idx > 0 ? "border-t border-slate-100" : "" %> hover:bg-slate-50/60 transition-colors">
                <td class="py-2.5 px-4 font-medium text-slate-800"><%= label %></td>
                <td class="py-2.5 px-4"><a class="text-indigo-600 hover:underline font-mono text-xs" href="<%= local %>"><%= local %></a></td>
                <td class="py-2.5 px-4"><a class="text-indigo-600 hover:underline" target="_blank" rel="noopener" href="https://pagespeed.web.dev/report?url=<%= CGI.escape(deployed + "?delay=50") %>">PageSpeed &rarr;</a></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Tips for credible numbers</h2>
      <p class="text-sm text-slate-600 mb-6 max-w-3xl">Single-run localhost numbers will look great on every variant. The differences only become real under throttling, with cache cleared, in incognito.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% [
          ["Use a fresh incognito window", "Browser extensions can add hundreds of ms to TBT."],
          ["Throttle to mobile", "4× CPU + Slow 3G. Localhost over fiber will show no real difference."],
          ["Median of 5 runs", "Single runs are noisy. Page-to-page variance is real."],
          ["Disable HTTP cache", "Use DevTools \"Disable cache\" or the --throttle flag in pnpm vitals."],
          ["Same warm/cold state", "Apples to apples — both runs cold or both runs warm."],
          ["Same window size", "Viewport changes the Speed Index calculation."],
        ].each do |title, body| %>
          <div class="flex gap-3">
            <span class="flex-shrink-0 mt-1 w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <div>
              <div class="text-sm font-semibold text-slate-800"><%= title %></div>
              <div class="text-xs text-slate-500 mt-0.5"><%= body %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</section>

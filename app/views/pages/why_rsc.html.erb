<!-- ════════════════════════════════════════════════════════════════
     PILLAR 3: BEYOND CODE SPLITTING — RSC vs @loadable
     ════════════════════════════════════════════════════════════════ -->
<section class="section-light py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal text-center mb-16">
      <span class="inline-block text-amber-600 font-semibold text-sm uppercase tracking-wider mb-3">RSC vs @loadable/component</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4">Beyond Code Splitting</h2>
      <p class="text-lg text-slate-500 max-w-3xl mx-auto">
        <code class="bg-slate-100 px-2 py-0.5 rounded text-sm">@loadable/component</code> defers <em>when</em> JavaScript loads.
        RSC <strong>eliminates</strong> it entirely. The difference between &ldquo;load this later&rdquo; and &ldquo;never load this at all.&rdquo;
      </p>
    </div>

    <!-- Side-by-Side Page Completeness SVG -->
    <div class="reveal max-w-4xl mx-auto mb-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Loadable: Gaps in initial HTML -->
      <div class="bg-orange-50 rounded-2xl border border-orange-200 p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-sm font-semibold text-orange-700">@loadable — Initial HTML Response</span>
        </div>
        <svg viewBox="0 0 300 230" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="@loadable initial HTML: header and hero are server-rendered but reviews and related items are missing, requiring JavaScript to render later">
          <rect x="10" y="10" width="280" height="210" rx="8" fill="white" stroke="#fed7aa" stroke-width="1.5"/>
          <!-- SSR'd content (present) -->
          <rect x="20" y="20" width="260" height="24" rx="4" fill="#6366f1"/>
          <text x="150" y="37" text-anchor="middle" fill="white" font-size="9" font-family="monospace">Header (SSR'd in HTML)</text>
          <rect x="20" y="52" width="260" height="40" rx="4" fill="#8b5cf6"/>
          <text x="150" y="77" text-anchor="middle" fill="white" font-size="9" font-family="monospace">Hero Content (SSR'd in HTML)</text>
          <!-- Lazy gaps (missing from HTML) with JS cost labels -->
          <rect x="20" y="100" width="260" height="35" rx="4" fill="#fff7ed" stroke="#f97316" stroke-width="2" stroke-dasharray="6,4"/>
          <text x="150" y="116" text-anchor="middle" fill="#c2410c" font-size="9" font-family="monospace" font-weight="bold">Reviews (empty until JS loads)</text>
          <text x="150" y="129" text-anchor="middle" fill="#9a3412" font-size="7" font-family="monospace">requires JS download + hydration</text>
          <rect x="20" y="143" width="260" height="35" rx="4" fill="#fff7ed" stroke="#f97316" stroke-width="2" stroke-dasharray="6,4"/>
          <text x="150" y="159" text-anchor="middle" fill="#c2410c" font-size="9" font-family="monospace" font-weight="bold">Related Items (empty until JS loads)</text>
          <text x="150" y="172" text-anchor="middle" fill="#9a3412" font-size="7" font-family="monospace">requires JS download + hydration</text>
          <!-- Summary -->
          <text x="150" y="198" text-anchor="middle" fill="#9a3412" font-size="10" font-family="monospace" font-weight="bold">Content missing from initial HTML</text>
          <text x="150" y="212" text-anchor="middle" fill="#9a3412" font-size="8" font-family="monospace">Invisible to search engines on first crawl</text>
        </svg>
      </div>

      <!-- RSC: Complete initial HTML -->
      <div class="bg-green-50 rounded-2xl border border-green-200 p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-sm font-semibold text-green-700">RSC — Initial HTML Response</span>
        </div>
        <svg viewBox="0 0 300 230" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="RSC initial HTML: all content including reviews and related items is fully server-rendered in the HTML with zero JavaScript cost">
          <rect x="10" y="10" width="280" height="210" rx="8" fill="white" stroke="#bbf7d0" stroke-width="1.5"/>
          <!-- All content present -->
          <rect x="20" y="20" width="260" height="24" rx="4" fill="#6366f1"/>
          <text x="150" y="37" text-anchor="middle" fill="white" font-size="9" font-family="monospace">Header (in HTML, 0 JS)</text>
          <rect x="20" y="52" width="260" height="40" rx="4" fill="#8b5cf6"/>
          <text x="150" y="77" text-anchor="middle" fill="white" font-size="9" font-family="monospace">Hero Content (in HTML, 0 JS)</text>
          <rect x="20" y="100" width="260" height="35" rx="4" fill="#34d399"/>
          <text x="150" y="116" text-anchor="middle" fill="white" font-size="9" font-family="monospace" font-weight="bold">Reviews (in HTML, 0 JS)</text>
          <text x="150" y="129" text-anchor="middle" fill="#d1fae5" font-size="7" font-family="monospace">no hydration needed</text>
          <rect x="20" y="143" width="260" height="35" rx="4" fill="#10b981"/>
          <text x="150" y="159" text-anchor="middle" fill="white" font-size="9" font-family="monospace" font-weight="bold">Related Items (in HTML, 0 JS)</text>
          <text x="150" y="172" text-anchor="middle" fill="#d1fae5" font-size="7" font-family="monospace">no hydration needed</text>
          <!-- Summary -->
          <text x="150" y="198" text-anchor="middle" fill="#166534" font-size="10" font-family="monospace" font-weight="bold">100% content in initial HTML</text>
          <text x="150" y="212" text-anchor="middle" fill="#166534" font-size="8" font-family="monospace">Fully visible to search engines on first crawl</text>
        </svg>
      </div>
    </div>

    <!-- The Tradeoff Explanation -->
    <div class="reveal max-w-4xl mx-auto mb-16 bg-amber-50 border border-amber-200 rounded-2xl p-8">
      <h3 class="font-bold text-lg text-slate-900 mb-4">The @loadable/component Tradeoff</h3>
      <p class="text-slate-600 mb-4">
        You <em>can</em> SSR every loadable component &mdash; but the architecture forces a painful choice:
      </p>
      <div class="space-y-3">
        <div class="flex gap-3">
          <span class="flex-shrink-0 w-6 h-6 bg-amber-200 text-amber-800 rounded-full flex items-center justify-center text-xs font-bold">1</span>
          <p class="text-sm text-slate-600"><strong class="text-slate-800">SSR&rsquo;ing everything delays TTFB and FCP</strong> &mdash; <code>@loadable</code>&rsquo;s ChunkExtractor requires <code>renderToString</code>, which cannot stream. The server must finish rendering all components before sending any HTML.</p>
        </div>
        <div class="flex gap-3">
          <span class="flex-shrink-0 w-6 h-6 bg-amber-200 text-amber-800 rounded-full flex items-center justify-center text-xs font-bold">2</span>
          <p class="text-sm text-slate-600"><strong class="text-slate-800">Every SSR&rsquo;d component still needs JS for hydration</strong> &mdash; the HTML is visible but frozen until its JavaScript downloads, parses, and executes. More components = more JS = higher TTI.</p>
        </div>
        <div class="flex gap-3">
          <span class="flex-shrink-0 w-6 h-6 bg-amber-200 text-amber-800 rounded-full flex items-center justify-center text-xs font-bold">3</span>
          <p class="text-sm text-slate-600"><strong class="text-slate-800">So teams are forced to choose:</strong> SSR critical components for fast FCP (non-critical content missing from HTML), or SSR everything for complete HTML (but slow FCP and heavy hydration).</p>
        </div>
      </div>
      <div class="mt-5 bg-emerald-100 border border-emerald-300 rounded-xl p-4">
        <p class="text-sm text-emerald-800 font-semibold">RSC eliminates this tradeoff. Server components are in the initial HTML AND cost zero JavaScript AND require zero hydration. No penalty for rendering everything on the server.</p>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="reveal max-w-4xl mx-auto mb-16 overflow-x-auto">
      <table class="comparison-table w-full rounded-2xl overflow-hidden border border-slate-200 bg-white text-sm">
        <thead>
          <tr>
            <th class="rounded-tl-2xl" style="width: 20%;">Aspect</th>
            <th class="loadable-col" style="width: 40%;">@loadable/component</th>
            <th class="rsc-col rounded-tr-2xl" style="width: 40%;">React Server Components</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="font-semibold text-slate-700">JS to client</td>
            <td class="loadable-col text-slate-600">Full component code in lazy chunks &mdash; <strong>deferred, not eliminated</strong></td>
            <td class="rsc-col text-slate-600"><strong class="text-emerald-700">Zero</strong> for server components &mdash; truly eliminated</td>
          </tr>
          <tr>
            <td class="font-semibold text-slate-700">Hydration</td>
            <td class="loadable-col text-slate-600">Required for <strong>every</strong> component, including lazy ones after chunks load</td>
            <td class="rsc-col text-slate-600">Only for interactive <code class="bg-emerald-100 px-1 rounded text-xs">'use client'</code> components</td>
          </tr>
          <tr>
            <td class="font-semibold text-slate-700">Setup</td>
            <td class="loadable-col text-slate-600">5 packages + webpack plugin + SWC/Babel plugin + ChunkExtractor + loadableReady</td>
            <td class="rsc-col text-slate-600">Add <code class="bg-emerald-100 px-1 rounded text-xs">'use client'</code> to interactive components. Done.</td>
          </tr>
          <tr>
            <td class="font-semibold text-slate-700">Code splitting</td>
            <td class="loadable-col text-slate-600">Manual &mdash; wrap each import with <code class="bg-orange-100 px-1 rounded text-xs">loadable()</code></td>
            <td class="rsc-col text-slate-600"><strong class="text-emerald-700">Automatic</strong> at every client component boundary</td>
          </tr>
          <tr>
            <td class="font-semibold text-slate-700">SEO</td>
            <td class="loadable-col text-slate-600">Lazy content absent from initial HTML &mdash; depends on Google&rsquo;s JS rendering queue</td>
            <td class="rsc-col text-slate-600"><strong class="text-emerald-700">All content</strong> in initial HTML &mdash; indexed on first crawl</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- SEO Deep Dive -->
    <div class="reveal max-w-4xl mx-auto bg-slate-50 border border-slate-200 rounded-2xl p-8">
      <h3 class="font-bold text-lg text-slate-900 mb-3">Why This Matters for SEO</h3>
      <p class="text-sm text-slate-600 mb-4">
        Google indexes pages in two waves. The first wave reads raw HTML immediately. The second wave renders JavaScript &mdash; but with a <strong>median delay of ~10 seconds</strong>, up to <strong>18 hours</strong> at the 99th percentile.
      </p>
      <p class="text-sm text-slate-600 mb-4">
        Content behind lazy-loaded components &mdash; reviews, recommendations, comments &mdash; is exactly the <strong>long-tail keyword-rich content</strong> that drives organic search traffic. With <code class="bg-slate-200 px-1 rounded text-xs">@loadable</code>, this content is invisible to the first wave. With RSC, it&rsquo;s all in the initial HTML.
      </p>

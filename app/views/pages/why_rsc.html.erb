<% content_for :head do %>
<style>
  /* ── Scroll-reveal animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Hero gradient ── */
  .hero-gradient {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #172554 100%);
  }
  .hero-glow {
    background: radial-gradient(ellipse 60% 50% at 50% 40%, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
  }

  /* ── Timeline animation (Hero) ── */
  .timeline-bar {
    transform-origin: left;
    transform: scaleX(0);
    animation: grow-bar 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .timeline-bar-delay-1 { animation-delay: 0.3s; }
  .timeline-bar-delay-2 { animation-delay: 0.8s; }
  .timeline-bar-delay-3 { animation-delay: 1.3s; }
  .timeline-bar-delay-4 { animation-delay: 1.8s; }

  @keyframes grow-bar {
    to { transform: scaleX(1); }
  }
  @keyframes grow-line {
    to { transform: scaleY(1); }
  }

  /* ── Streaming blocks animation ── */
  @keyframes stream-in {
    0% { opacity: 0.15; background-color: #e2e8f0; }
    100% { opacity: 1; background-color: var(--stream-color, #6366f1); }
  }
  .stream-block {
    animation: stream-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0.15;
  }

  /* ── Bundle shrink animation ── */
  @keyframes shrink-bundle {
    0% { max-width: 100%; }
    100% { max-width: var(--target-width); }
  }
  .bundle-bar-animate {
    animation: shrink-bundle 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-play-state: paused;
    will-change: max-width;
  }
  .visible .bundle-bar-animate {
    animation-play-state: running;
  }

  /* ── Pulse glow for metrics ── */
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.2); }
    50% { box-shadow: 0 0 20px 4px rgba(99, 102, 241, 0.15); }
  }
  .metric-card:hover {
    animation: pulse-glow 2s ease-in-out infinite;
  }

  /* ── Gradient text fix ── */
  .gradient-text {
    background: linear-gradient(to right, #818cf8, #a78bfa, #f472b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Code block styling ── */
  .code-block {
    background: #1e293b;
    border-radius: 12px;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.7;
    font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', ui-monospace, monospace;
  }
  @media (min-width: 640px) {
    .code-block { font-size: 0.875rem; }
  }
  .code-block pre {
    margin: 0;
    padding: 1rem 1rem;
    overflow-x: auto;
    flex: 1;
  }
  @media (min-width: 640px) {
    .code-block pre { padding: 1.5rem 1.75rem; }
  }
  .code-header {
    background: #334155;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .code-dot { width: 10px; height: 10px; border-radius: 50%; }

  /* Syntax colors */
  .syn-kw { color: #c084fc; }   /* keyword: async, function, const, await, import, from, export, default, return */
  .syn-fn { color: #67e8f9; }   /* function name */
  .syn-str { color: #86efac; }  /* string */
  .syn-cm { color: #64748b; }   /* comment */
  .syn-ty { color: #fbbf24; }   /* type / tag */
  .syn-op { color: #94a3b8; }   /* operator / punctuation */
  .syn-prop { color: #f9a8d4; } /* property */
  .syn-num { color: #fbbf24; }  /* number */
  .syn-dir { color: #fb923c; }  /* directive */

  /* ── Comparison page SVG ── */
  @keyframes fade-in-block {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
  .page-block {
    animation: fade-in-block 0.4s ease forwards;
    opacity: 0;
  }

  /* ── Streaming demo: Traditional SSR (all at once after long wait) ── */
  @keyframes ssr-shimmer {
    0%, 70% { opacity: 0.3; }
    71%, 72% { opacity: 0.5; }
    73% { opacity: 0.3; }
  }
  @keyframes ssr-appear-all {
    0%, 74% { opacity: 0; }
    75% { opacity: 1; }
    95% { opacity: 1; }
    100% { opacity: 0; }
  }
  .ssr-skeleton {
    animation: ssr-shimmer 8s ease-in-out infinite;
  }
  .ssr-content {
    animation: ssr-appear-all 8s ease infinite;
    opacity: 0;
  }

  /* ── Streaming demo: RSC (progressive, one by one) ── */
  @keyframes rsc-appear {
    0%, var(--start) { opacity: 0; transform: translateY(4px); }
    var(--end) { opacity: 1; transform: translateY(0); }
    87% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(0); }
  }
  .rsc-block-0 { animation: rsc-block-anim0 8s ease infinite; opacity: 0; }
  .rsc-block-1 { animation: rsc-block-anim1 8s ease infinite; opacity: 0; }
  .rsc-block-2 { animation: rsc-block-anim2 8s ease infinite; opacity: 0; }
  .rsc-block-3 { animation: rsc-block-anim3 8s ease infinite; opacity: 0; }
  @keyframes rsc-block-anim0 {
    0%, 4% { opacity: 0; } 5% { opacity: 1; } 90% { opacity: 1; } 100% { opacity: 0; }
  }
  @keyframes rsc-block-anim1 {
    0%, 14% { opacity: 0; } 15% { opacity: 1; } 90% { opacity: 1; } 100% { opacity: 0; }
  }
  @keyframes rsc-block-anim2 {
    0%, 29% { opacity: 0; } 30% { opacity: 1; } 90% { opacity: 1; } 100% { opacity: 0; }
  }
  @keyframes rsc-block-anim3 {
    0%, 49% { opacity: 0; } 50% { opacity: 1; } 90% { opacity: 1; } 100% { opacity: 0; }
  }
  /* RSC skeleton that fades out as content appears */
  .rsc-skel-0 { animation: rsc-skel-anim0 8s ease infinite; }
  .rsc-skel-1 { animation: rsc-skel-anim1 8s ease infinite; }
  .rsc-skel-2 { animation: rsc-skel-anim2 8s ease infinite; }
  .rsc-skel-3 { animation: rsc-skel-anim3 8s ease infinite; }
  @keyframes rsc-skel-anim0 {
    0%, 4% { opacity: 1; } 5% { opacity: 0; } 100% { opacity: 0; }
  }
  @keyframes rsc-skel-anim1 {
    0%, 14% { opacity: 1; } 15% { opacity: 0; } 100% { opacity: 0; }
  }
  @keyframes rsc-skel-anim2 {
    0%, 29% { opacity: 1; } 30% { opacity: 0; } 100% { opacity: 0; }
  }
  @keyframes rsc-skel-anim3 {
    0%, 49% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 0; }
  }

  /* ── Floating particles in hero ── */
  @keyframes float-particle {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.4; }
    50% { transform: translateY(-20px) rotate(180deg); opacity: 0.8; }
  }
  .particle {
    animation: float-particle var(--duration, 4s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  /* ── Section divider wave ── */
  .wave-divider {
    position: relative;
    margin-top: -1px;
  }

  /* ── Smooth gradient sections ── */
  .section-light { background: #ffffff; }
  .section-muted { background: #f8fafc; }
  .section-dark { background: #0f172a; color: #e2e8f0; }

  /* ── Comparison table ── */
  .comparison-table th {
    background: #f1f5f9;
    font-weight: 600;
    text-align: left;
  }
  .comparison-table td, .comparison-table th {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .comparison-table tr:last-child td { border-bottom: none; }
  .comparison-table .rsc-col { background: #f0fdf4; }
  .comparison-table .loadable-col { background: #fff7ed; }

  /* ── Accessibility: reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .reveal { transition: none; opacity: 1; transform: none; }
    .timeline-bar { animation: none; transform: scaleX(1); }
    line[style*="grow-line"] { animation: none !important; transform: scaleY(1) !important; }
    .stream-block { animation: none; opacity: 1; }
    .bundle-bar-animate { animation: none; max-width: var(--target-width); }
    .particle { animation: none; opacity: 0.4; }
    .page-block { animation: none; opacity: 1; }
    .ssr-skeleton { animation: none; opacity: 0; }
    .ssr-content { animation: none; opacity: 1; }
    .rsc-block-0, .rsc-block-1, .rsc-block-2, .rsc-block-3 { animation: none; opacity: 1; }
    .rsc-skel-0, .rsc-skel-1, .rsc-skel-2, .rsc-skel-3 { animation: none; opacity: 0; }
  }
</style>
<% end %>

<!-- ════════════════════════════════════════════════════════════════
     HERO SECTION
     ════════════════════════════════════════════════════════════════ -->
<section class="hero-gradient relative overflow-hidden">
  <div class="hero-glow absolute inset-0"></div>

  <!-- Floating particles -->
  <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle class="particle" cx="10%" cy="20%" r="2" fill="#818cf8" style="--duration: 5s; --delay: 0s;" />
    <circle class="particle" cx="85%" cy="15%" r="1.5" fill="#a78bfa" style="--duration: 4s; --delay: 1s;" />
    <circle class="particle" cx="70%" cy="80%" r="2" fill="#6366f1" style="--duration: 6s; --delay: 0.5s;" />
    <circle class="particle" cx="25%" cy="75%" r="1.5" fill="#818cf8" style="--duration: 4.5s; --delay: 2s;" />
    <circle class="particle" cx="50%" cy="40%" r="1" fill="#c4b5fd" style="--duration: 3.5s; --delay: 1.5s;" />
    <rect class="particle" x="90%" y="60%" width="3" height="3" rx="0.5" fill="#818cf8" style="--duration: 5.5s; --delay: 0.8s;" />
    <rect class="particle" x="15%" y="50%" width="2.5" height="2.5" rx="0.5" fill="#a78bfa" style="--duration: 4.2s; --delay: 2.5s;" />
  </svg>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 sm:pt-32 sm:pb-40 text-center">
    <div class="inline-flex items-center gap-2 bg-indigo-500/10 border border-indigo-400/20 rounded-full px-4 py-1.5 mb-8">
      <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
      <span class="text-indigo-300 text-sm font-medium">React on Rails Pro</span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight">
      Deliver Faster Pages<br/>
      <span class="gradient-text">Without Rebuilding Your App</span>
    </h1>

    <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-14 leading-relaxed">
      Faster load times. Higher engagement. Lower development costs.<br class="hidden sm:block"/>
      React Server Components improve the metrics that drive conversions, SEO, and team velocity.
    </p>

    <!-- Hero SVG: Traditional vs RSC Timeline -->
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
      <!-- Traditional Timeline -->
      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-5">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="#f87171" stroke-width="2"/><path d="M7 7l6 6M13 7l-6 6" stroke="#f87171" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="text-red-400 font-semibold text-sm uppercase tracking-wider">Traditional SSR</span>
        </div>
        <svg viewBox="0 0 340 195" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="Traditional SSR timeline: server fetches all data then renders HTML, browser downloads JS and renders HTML in parallel, but hydration waits for both to complete, taking 4-6 seconds total">
          <!-- Server-side label -->
          <text x="0" y="10" fill="#64748b" font-size="8" font-family="monospace" font-weight="bold">SERVER</text>
          <line x1="0" y1="14" x2="100" y2="14" stroke="#334155" stroke-width="0.5"/>
          <!-- Server-side steps -->
          <text x="0" y="34" fill="#94a3b8" font-size="11" font-family="monospace">Fetch all data</text>
          <text x="0" y="62" fill="#94a3b8" font-size="11" font-family="monospace">Render HTML</text>
          <!-- Server bars: sequential -->
          <rect x="110" y="22" width="55" height="16" rx="4" fill="#ef4444" class="timeline-bar"/>
          <rect x="165" y="50" width="45" height="16" rx="4" fill="#f97316" class="timeline-bar timeline-bar-delay-1"/>
          <!-- Blocked connector: fetch → render -->
          <line x1="165" y1="38" x2="165" y2="50" stroke="#475569" stroke-width="1" stroke-dasharray="3,2"/>
          <text x="170" y="47" fill="#64748b" font-size="7" font-family="monospace">blocked</text>
          <!-- Browser-side label -->
          <text x="0" y="86" fill="#64748b" font-size="8" font-family="monospace" font-weight="bold">BROWSER</text>
          <line x1="0" y1="90" x2="100" y2="90" stroke="#334155" stroke-width="0.5"/>
          <!-- Browser-side steps -->
          <text x="0" y="108" fill="#94a3b8" font-size="11" font-family="monospace">Render HTML</text>
          <text x="0" y="130" fill="#94a3b8" font-size="11" font-family="monospace">Download JS</text>
          <text x="0" y="156" fill="#94a3b8" font-size="11" font-family="monospace">Hydrate all</text>
          <!-- Browser bars: render HTML and download JS start in parallel after server responds -->
          <rect x="210" y="96" width="55" height="16" rx="4" fill="#f97316" class="timeline-bar timeline-bar-delay-2"/>
          <rect x="210" y="118" width="70" height="16" rx="4" fill="#eab308" class="timeline-bar timeline-bar-delay-2"/>
          <!-- Parallel annotation -->
          <text x="212" y="141" fill="#64748b" font-size="7" font-family="monospace">parallel</text>
          <!-- Connector from server render → browser (response sent) -->
          <line x1="210" y1="66" x2="210" y2="96" stroke="#475569" stroke-width="1" stroke-dasharray="3,2"/>
          <text x="214" y="82" fill="#64748b" font-size="7" font-family="monospace">response</text>
          <!-- Hydrate bar: starts after BOTH HTML render and JS download complete -->
          <rect x="280" y="144" width="50" height="16" rx="4" fill="#f87171" class="timeline-bar timeline-bar-delay-3"/>
          <!-- Converging lines: both feed into hydrate -->
          <line x1="265" y1="108" x2="280" y2="148" stroke="#475569" stroke-width="1" stroke-dasharray="3,2"/>
          <line x1="280" y1="130" x2="280" y2="144" stroke="#475569" stroke-width="1" stroke-dasharray="3,2"/>
          <text x="284" y="142" fill="#64748b" font-size="7" font-family="monospace">waits for both</text>
          <!-- Time span indicator -->
          <line x1="110" y1="172" x2="330" y2="172" stroke="#64748b" stroke-width="1"/>
          <line x1="110" y1="168" x2="110" y2="176" stroke="#64748b" stroke-width="1"/>
          <line x1="330" y1="168" x2="330" y2="176" stroke="#64748b" stroke-width="1"/>
          <text x="220" y="190" text-anchor="middle" fill="#ef4444" font-size="10" font-family="monospace" font-weight="bold">~4-6s before anything is interactive</text>
        </svg>
      </div>

      <!-- RSC Timeline -->
      <div class="bg-white/5 backdrop-blur-sm border border-emerald-400/20 rounded-2xl p-6 ring-1 ring-emerald-400/10">
        <div class="flex items-center gap-2 mb-5">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="#34d399" stroke-width="2"/><path d="M6 10l3 3 5-6" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-emerald-400 font-semibold text-sm uppercase tracking-wider">RSC + Streaming</span>
        </div>
        <svg viewBox="0 0 360 170" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="RSC streaming timeline: steps run concurrently with minimal JS, page becomes interactive in about 1.3 seconds">
          <!-- Labels -->
          <text x="0" y="24" fill="#94a3b8" font-size="11" font-family="monospace">Shell HTML</text>
          <text x="0" y="58" fill="#94a3b8" font-size="11" font-family="monospace">Stream content</text>
          <text x="0" y="92" fill="#94a3b8" font-size="11" font-family="monospace">Minimal JS</text>
          <text x="0" y="126" fill="#94a3b8" font-size="11" font-family="monospace">Selective hydrate</text>
          <!-- Concurrent bars: all start at same x to show parallelism -->
          <rect x="130" y="12" width="25" height="18" rx="4" fill="#34d399" class="timeline-bar"/>
          <text x="158" y="25" fill="#34d399" font-size="7" font-family="monospace" font-weight="bold">instant!</text>
          <rect x="130" y="46" width="120" height="18" rx="4" fill="#6366f1" opacity="0.15"/>
          <rect x="130" y="46" width="120" height="18" rx="4" fill="#6366f1" class="timeline-bar timeline-bar-delay-1"/>
          <rect x="130" y="80" width="35" height="18" rx="4" fill="#8b5cf6" opacity="0.15"/>
          <rect x="130" y="80" width="35" height="18" rx="4" fill="#8b5cf6" class="timeline-bar timeline-bar-delay-1"/>
          <text x="169" y="93" fill="#a78bfa" font-size="7" font-family="monospace">tiny bundle</text>
          <rect x="130" y="114" width="50" height="18" rx="4" fill="#34d399" opacity="0.15"/>
          <rect x="130" y="114" width="50" height="18" rx="4" fill="#34d399" class="timeline-bar timeline-bar-delay-2"/>
          <!-- "concurrent" annotation -->
          <text x="130" y="142" fill="#64748b" font-size="7" font-family="monospace">all steps overlap</text>
          <!-- Interactive marker line -->
          <line x1="180" y1="4" x2="180" y2="136" stroke="#34d399" stroke-width="1.5" stroke-dasharray="4,3" style="transform-origin: 180px 4px; transform: scaleY(0); animation: grow-line 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;"/>
          <!-- Time span indicator (much shorter) -->
          <line x1="130" y1="152" x2="180" y2="152" stroke="#34d399" stroke-width="1"/>
          <line x1="130" y1="148" x2="130" y2="156" stroke="#34d399" stroke-width="1"/>
          <line x1="180" y1="148" x2="180" y2="156" stroke="#34d399" stroke-width="1"/>
          <text x="155" y="167" text-anchor="middle" fill="#34d399" font-size="10" font-family="monospace" font-weight="bold">~1.3s interactive</text>
        </svg>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="wave-divider">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full block">
      <path d="M0 60V30C240 0 480 0 720 30C960 60 1200 60 1440 30V60H0Z" fill="#ffffff"/>
    </svg>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     PILLAR 1: LIGHTER APPS, FASTER LOADS
     ════════════════════════════════════════════════════════════════ -->
<section class="section-light py-14 sm:py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="reveal text-center mb-10 sm:mb-16">
      <span class="inline-block text-indigo-600 font-semibold text-sm uppercase tracking-wider mb-3">Performance</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4">Faster Pages, Higher Conversions</h2>
      <p class="text-lg text-slate-500 max-w-2xl mx-auto">
        Your pages load faster because heavy processing happens on the server instead of your users' phones and laptops. Less code to download means faster pages and better Google performance scores.
      </p>
    </div>

    <!-- What Gets Sent to the Browser -->
    <div class="reveal max-w-4xl mx-auto mb-10 sm:mb-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Traditional: everything ships -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <span class="text-sm font-semibold text-slate-700">Traditional &mdash; What Ships to Browser</span>
        </div>
        <svg viewBox="0 0 280 180" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="Traditional: server sends large JS bundle with app code, markdown library, chart library, and date utils all included">
          <!-- Server -->
          <rect x="10" y="10" width="80" height="40" rx="8" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
          <text x="50" y="35" text-anchor="middle" fill="#64748b" font-size="10" font-family="monospace">Server</text>
          <!-- Arrow (thick = heavy payload) -->
          <rect x="100" y="22" width="80" height="16" rx="4" fill="#fecaca"/>
          <text x="140" y="34" text-anchor="middle" fill="#dc2626" font-size="8" font-family="monospace" font-weight="bold">450 KB JS</text>
          <!-- Browser -->
          <rect x="190" y="10" width="80" height="40" rx="8" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
          <text x="230" y="35" text-anchor="middle" fill="#64748b" font-size="10" font-family="monospace">Browser</text>
          <!-- What's inside the bundle -->
          <text x="10" y="75" fill="#64748b" font-size="9" font-family="monospace" font-weight="bold">JS bundle contains:</text>
          <rect x="10" y="82" width="260" height="18" rx="4" fill="#ef4444" opacity="0.15"/>
          <text x="140" y="95" text-anchor="middle" fill="#dc2626" font-size="8" font-family="monospace">App components + hooks + state (170 KB)</text>
          <rect x="10" y="104" width="260" height="18" rx="4" fill="#f97316" opacity="0.15"/>
          <text x="140" y="117" text-anchor="middle" fill="#c2410c" font-size="8" font-family="monospace">marked + highlight.js (240 KB)</text>
          <rect x="10" y="126" width="260" height="18" rx="4" fill="#eab308" opacity="0.15"/>
          <text x="140" y="139" text-anchor="middle" fill="#a16207" font-size="8" font-family="monospace">d3 charts + date-fns (40 KB)</text>

<section id="demos" class="section-light py-14 sm:py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="reveal text-center mb-10 sm:mb-16">
      <span class="inline-block text-emerald-600 font-semibold text-sm uppercase tracking-wider mb-3">Live Demo</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4">See It In Action</h2>
      <p class="text-lg text-slate-500 max-w-3xl mx-auto">
        Four real-world page types, each built three ways to prove the performance difference. Ordered by mobile performance improvement.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto mb-8">
      <!-- 1) Blog Post — biggest mobile perf gain (+25 points). Markdown libs
           stay server-side on RSC; SSR/Client variants ship marked + highlight.js. -->
      <%= render partial: "demo_card", locals: {
        title: "Blog Post",
        description: "Markdown-heavy article with code blocks. RSC keeps marked + highlight.js entirely server-side. Mobile perf gain: +25 (72→97).",
        base_path: "/blog",
        icon_bg: "bg-violet-100",
        icon_svg: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="4" y="3" width="12" height="14" rx="2" stroke="#7c3aed" stroke-width="1.5"/><path d="M7 7h6M7 10h6M7 13h4" stroke="#7c3aed" stroke-width="1.5" stroke-linecap="round"/></svg>',
        report_slug: "blog",
        bundle_anchor: "blog",
      } %>

      <!-- 2) Product Page — +25 mobile perf. Markdown spec sheet + multi-currency
           pricing stay server-side on RSC. -->
      <%= render partial: "demo_card", locals: {
        title: "Product Page",
        description: "E-commerce page with markdown spec sheet, reviews, multi-currency pricing. Mobile perf gain: +25 (73→98) — 404 KB less transfer.",
        base_path: "/product",
        icon_bg: "bg-blue-100",
        icon_svg: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="5" width="14" height="10" rx="2" stroke="#2563eb" stroke-width="1.5"/><path d="M7 5V3a3 3 0 0 1 6 0v2" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round"/></svg>',
        report_slug: "product",
        bundle_anchor: "product",
      } %>


<%#
  Locals:
    title: String
    description: String
    base_path: String e.g. "/blog" — variants are "#{base_path}/ssr", etc.
    icon_bg: String tailwind classes for icon container background
    icon_svg: HTML safe string with the inline SVG icon
    report_slug: String — slug used for /lighthouse-reports/{slug}_{ssr|client|rsc}-{desktop|mobile}.html
    bundle_anchor: String — anchor in /lighthouse-reports/bundle-sizes.html (e.g. "blog")
%>
<div class="reveal demo-card bg-white rounded-2xl border border-slate-200 p-6 block group">
  <div class="w-10 h-10 <%= icon_bg %> rounded-xl flex items-center justify-center mb-4">
    <%= icon_svg.html_safe %>
  </div>
  <h3 class="font-bold text-slate-900 mb-2"><%= title %></h3>
  <p class="text-sm text-slate-500 mb-4"><%= description %></p>

  <% if local_assigns[:report_slug].present? %>
    <div class="flex flex-wrap items-center gap-1 mb-3 text-[10px] uppercase tracking-wider">
      <span class="text-slate-500 font-semibold mr-1">Evidence:</span>
      <a href="<%= lh_compare_url_for(report_slug, "ssr",    "desktop") %>" class="text-amber-700 hover:underline">SSR vs RSC ↗</a>
      <span class="text-slate-300">·</span>
      <a href="<%= lh_compare_url_for(report_slug, "client", "desktop") %>" class="text-blue-700 hover:underline">Client vs RSC ↗</a>
      <span class="text-slate-300">·</span>
      <a href="<%= lh_compare_url_for(report_slug, "rsc",    "desktop") %>" class="text-green-700 font-semibold hover:underline">RSC vs SSR ↗</a>
      <% if local_assigns[:bundle_anchor].present? %>
        <span class="text-slate-300">·</span>
        <a href="/lighthouse-reports/bundle-sizes.html#<%= bundle_anchor %>" class="text-indigo-700 hover:underline">Bundle ↗</a>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-2 text-xs flex-wrap">
    <a href="<%= base_path %>/ssr" class="rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-amber-700 hover:bg-amber-100 hover:border-amber-300 transition-colors">SSR</a>
    <a href="<%= base_path %>/client" class="rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-blue-700 hover:bg-blue-100 hover:border-blue-300 transition-colors">Client</a>
    <a href="<%= base_path %>/rsc" class="rounded-full bg-green-50 border border-green-200 px-2 py-0.5 text-green-700 font-semibold hover:bg-green-100 hover:border-green-300 transition-colors">RSC</a>
    <% if local_assigns[:extra_variants].present? %>
      <% extra_variants.each do |label, path_suffix, classes| %>
        <a href="<%= base_path %>/<%= path_suffix %>" class="<%= classes %>"><%= label %></a>
      <% end %>
    <% end %>
  </div>
</div>

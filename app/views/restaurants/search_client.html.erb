<% search_page = react_component_hash(
  "SearchPageClient",
  props: {
    restaurants: @restaurants,
    query: params[:q] || '',
    cuisine: params[:cuisine] || '',
    city: params[:city] || '',
    facets: @facets,
  },
  prerender: true
) %>
<% content_for :head do %>
  <%= search_page["linkTags"] %>
  <%= search_page["scriptTags"] %>
  <%= search_page["styleTags"] %>
<% end %>
<%= search_page["componentHtml"] %>

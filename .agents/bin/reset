#!/usr/bin/env bash
# Reset the run-scoped QA database and caches to baseline.
# Requires: QA_RUN_ID. Uses SEED_MODE=small by default.
set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

: "${QA_RUN_ID:?QA_RUN_ID is required — set it to a unique run identifier}"

# Validate QA_RUN_ID format
if [[ ! "${QA_RUN_ID}" =~ ^[A-Za-z0-9_-]+$ ]]; then
  printf 'FATAL: QA_RUN_ID contains invalid characters: %s\n' "${QA_RUN_ID}" >&2
  exit 1
fi

readonly RUN_DB="localhub_demo_qa_${QA_RUN_ID}"

if [[ -n "${DATABASE_USERNAME:-}" ]]; then
  export DATABASE_URL="postgres://${DATABASE_USERNAME}:${DATABASE_PASSWORD:-}@localhost/${RUN_DB}"
else
  export DATABASE_URL="postgres://localhost/${RUN_DB}"
fi
export RAILS_ENV=production
export SEED_MODE="${SEED_MODE:-small}"

# Rails protects production databases from destructive actions by default.
# Since QA_RUN_ID validation already guarantees this is a qa_-prefixed DB,
# bypass the protected-environment check so db:drop works.
export DISABLE_DATABASE_ENVIRONMENT_CHECK=1

# Generate a throwaway secret so Rails boots in production mode
export SECRET_KEY_BASE
SECRET_KEY_BASE="$(openssl rand -hex 64)"

printf 'reset: dropping database %s\n' "${RUN_DB}"

# Terminate active connections to the QA database so db:drop succeeds even
# when serve is still running (the QA-stress skill may call reset between
# hypotheses without stopping the server).
if command -v psql >/dev/null 2>&1; then
  psql -d postgres -c \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${RUN_DB}' AND pid <> pg_backend_pid();" \
    >/dev/null 2>&1 || true
fi

# Drop the database. Tolerate "does not exist" (first run or already dropped),
# but fail on real errors.
if ! drop_output="$(bin/rails db:drop 2>&1)"; then
  if echo "${drop_output}" | grep -qi 'does not exist'; then
    printf 'reset: database %s did not exist — continuing with create\n' "${RUN_DB}"
  else
    printf 'FATAL: failed to drop database %s:\n%s\n' "${RUN_DB}" "${drop_output}" >&2
    exit 1
  fi
fi

printf 'reset: recreating and seeding database %s (SEED_MODE=%s)\n' "${RUN_DB}" "${SEED_MODE}"
bin/rails db:prepare

# Clear node-renderer bundle cache
if [ -d .node-renderer-bundles ]; then
  printf 'reset: clearing .node-renderer-bundles/\n'
  rm -rf .node-renderer-bundles/*
fi

# Clear Rails cache
printf 'reset: clearing Rails cache\n'
bin/rails tmp:cache:clear 2>/dev/null || true

printf 'reset: database %s restored to baseline\n' "${RUN_DB}"

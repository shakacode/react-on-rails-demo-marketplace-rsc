#!/usr/bin/env bash
# Generated by shakacode/agent-workflows bin/push-downstream.
# Bootstrap the full local development environment.
set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

# Never trust a repository mise configuration on behalf of an operator. The
# mise CLI exposes the trust result as text, so accept only its exact trusted
# status and fail closed for every other result, including an output change.
if command -v mise >/dev/null 2>&1 && [ -f mise.toml ]; then
  if ! mise_trust_status="$(mise trust --show "${PWD}/mise.toml" 2>/dev/null)"; then
    printf '%s\n' \
      "Refusing to run setup: unable to determine whether this checkout's mise.toml is trusted." \
      'Review it, then run `mise trust mise.toml` manually and rerun .agents/bin/setup.' >&2
    exit 1
  fi
  if ! printf '%s\n' "${mise_trust_status}" | grep -Eq '^[^[:space:]].*: trusted$'; then
    printf '%s\n' \
      'Refusing to run setup: this checkout has an untrusted or unrecognized mise.toml trust status.' \
      'Review it, then run `mise trust mise.toml` manually and rerun .agents/bin/setup.' >&2
    exit 1
  fi
fi

exec bin/setup "$@"

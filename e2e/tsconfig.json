{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright/**/*.ts",
    "playwright/**/*.mts",
    "playwright/**/*.mjs",
    "playwright/**/*.js"
  ],
  "exclude": [
    "playwright-report",
    "test-results"
  ]
}

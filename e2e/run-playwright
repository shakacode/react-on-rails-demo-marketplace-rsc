#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"
export PATH="${repo_root}/e2e/bin:${PATH}"

if [[ "${E2E_RUNNER_LOCK_HELD:-}" != "1" ]]; then
  exec with-runner-lock marketplace-rsc-playwright-5017-3800 "${repo_root}/e2e/run-playwright" "$@"
fi

if [[ "$(pnpm --version)" != "9.15.2" ]]; then
  echo "Playwright E2E requires the package.json-pinned pnpm 9.15.2"
  exit 1
fi

export RAILS_ENV=test
export NODE_ENV=test
export E2E_RAILS_COMMANDS=1
E2E_RAILS_TOKEN="$(openssl rand -hex 32)"
export E2E_RAILS_TOKEN
export E2E_BASE_URL=http://127.0.0.1:5017
export RENDERER_URL=http://127.0.0.1:3800
export RENDERER_HOST=127.0.0.1
export RENDERER_PORT=3800
export RENDERER_PASSWORD=e2e-local-renderer
export RENDERER_LOG_LEVEL=warn
export RENDERER_WORKERS_COUNT=1
export SHAKAPACKER_ASSETS_BUNDLER=rspack

require-open-port 127.0.0.1 5017
require-open-port 127.0.0.1 3800

log_dir="${repo_root}/e2e/server-logs"
mkdir -p "${log_dir}"

renderer_pid=""
rails_pid=""

cleanup() {
  [[ -n "${renderer_pid}" ]] && kill "${renderer_pid}" 2>/dev/null || true
  [[ -n "${rails_pid}" ]] && kill "${rails_pid}" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

database_name="$(bin/rails runner 'print ActiveRecord::Base.connection_db_config.database')"
case "${database_name}" in
  *_test|*_playwright) ;;
  *)
    echo "Refusing E2E cleanup against non-test database: ${database_name}"
    exit 1
    ;;
esac

bin/rails db:prepare
bundle exec rake react_on_rails:generate_packs
bin/shakapacker

require-open-port 127.0.0.1 5017
require-open-port 127.0.0.1 3800

env -u E2E_RAILS_TOKEN node node-renderer.js > "${log_dir}/node-renderer.log" 2>&1 &
renderer_pid=$!
bundle exec rails server -b 127.0.0.1 -p 5017 > "${log_dir}/rails.log" 2>&1 &
rails_pid=$!

ready=false
for _ in {1..60}; do
  if ! kill -0 "${renderer_pid}" 2>/dev/null; then
    echo "Node renderer exited before the E2E server became ready"
    exit 1
  fi
  if ! kill -0 "${rails_pid}" 2>/dev/null; then
    echo "Rails exited before the E2E server became ready"
    exit 1
  fi
  if curl --fail --silent --show-error --connect-timeout 1 --max-time 2 "${E2E_BASE_URL}/up" > /dev/null \
    && ( : >"/dev/tcp/${RENDERER_HOST}/${RENDERER_PORT}" ) 2>/dev/null; then
    ready=true
    break
  fi
  sleep 1
done

if [[ "${ready}" != true ]]; then
  echo "Timed out waiting for ${E2E_BASE_URL}/up"
  exit 1
fi

./node_modules/.bin/playwright test --config=e2e/playwright.config.ts "$@"
